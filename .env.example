# Token del bot de Telegram (te lo da @BotFather). Ver README para el paso a paso.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID del chat/canal/grupo al que se enviará el reporte diario.
# Puede ser tu chat personal (número positivo) o un grupo/canal (número negativo, empieza con -100...)
TELEGRAM_CHAT_ID=123456789

