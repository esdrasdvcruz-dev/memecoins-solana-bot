# Base de datos (SQLite para desarrollo local; usa Postgres en producción)
DATABASE_URL="file:./dev.db"

# URL pública del sitio (usada para construir URLs de retorno/webhooks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Autenticación del panel de administración ---
# Secreto usado para firmar la sesión del admin (genera uno propio, 32+ caracteres aleatorios)
ADMIN_SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales usadas SOLO al correr `npm run db:seed` para crear el primer usuario admin
SEED_ADMIN_EMAIL="admin@negocio.com"
SEED_ADMIN_PASSWORD="CambiaEstaClave123"

# --- Conekta (tarjeta y transferencia SPEI en México) ---
# Obtén tus llaves en https://panel.conekta.com -> Desarrollo -> API Keys
CONEKTA_PRIVATE_KEY="key_xxxxxxxxxxxxxxxxxxxxxxxx"
CONEKTA_API_VERSION="2.1.0"
# Usuario/contraseña que configures en Conekta para firmar el webhook (Panel -> Webhooks)
CONEKTA_WEBHOOK_USER="webhook_user"
CONEKTA_WEBHOOK_PASSWORD="webhook_password"

# --- NOWPayments (pagos con cripto) ---
# Regístrate en https://nowpayments.io -> Store Settings -> genera tu API key
NOWPAYMENTS_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
# Secreto IPN (misma sección de Store Settings) para verificar los webhooks
NOWPAYMENTS_IPN_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Moneda fiat para calcular el precio en cripto. Verifica en tu cuenta si "mxn" está
# soportada para conversión; si no, cambia a "usd".
NOWPAYMENTS_PRICE_CURRENCY="mxn"

# --- Datos bancarios para transferencia internacional (mostrados al cliente) ---
INTL_BANK_NAME="Nombre del banco"
INTL_BANK_ACCOUNT_HOLDER="Nombre del titular / razón social"
INTL_BANK_IBAN_OR_ACCOUNT="0000000000000000"
INTL_BANK_SWIFT="XXXXXXXX"
